<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GeneCodeCS</RootNamespace>
    <AssemblyName>GeneCodeCS</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1587;CS1570;CS1572;CS1574;CS1584;CS1658;CS1710;CS1711;CS1712;CS8981</NoWarn>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <Version>0.2.0</Version>
    <Authors>Edd Porter</Authors>
    <Description>Genetic programming library for code bot natural selection.</Description>
    <Copyright>Copyright © Edd Porter 2013</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageId>GeneCodeCS</PackageId>
    <PackageTags>genetic-programming;evolutionary-computation;machine-learning</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EddPorter/GeneCodeCS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Common.Logging" Version="3.4.1" />
    <InternalsVisibleTo Include="GeneCodeCS.Test" />
  </ItemGroup>

</Project>
